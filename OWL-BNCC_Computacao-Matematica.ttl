@prefix : <http://example.com#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix gufo: <http://purl.org/nemo/gufo#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://example.com#> .

<http://example.com> rdf:type owl:Ontology ;
                      owl:imports gufo: .

#################################################################
#    Object Properties
#################################################################

###  http://example.com#contem_conceito
:contem_conceito rdf:type owl:ObjectProperty ;
                 owl:inverseOf :pertence_a_unidade ;
                 rdfs:domain :UnidadeTematica ;
                 rdfs:range :ConceitoDisciplinar .


###  http://example.com#ensinoFundamental2HasDisciplina
:ensinoFundamental2HasDisciplina rdf:type owl:ObjectProperty ;
                                 rdfs:domain :EnsinoFundamental2 ;
                                 rdfs:range :Disciplina .


###  http://example.com#especifica
:especifica rdf:type owl:ObjectProperty ;
            owl:inverseOf :especificado_por ;
            rdfs:domain :AnoEscolar ;
            rdfs:range :ConceitoDisciplinar .


###  http://example.com#especificado_por
:especificado_por rdf:type owl:ObjectProperty ;
                  rdfs:domain :ConceitoDisciplinar ;
                  rdfs:range :AnoEscolar .


###  http://example.com#pertence_a_disciplina
:pertence_a_disciplina rdf:type owl:ObjectProperty ;
                       owl:inverseOf :possui_unidade ;
                       rdfs:domain :UnidadeTematica ;
                       rdfs:range :Disciplina .


###  http://example.com#pertence_a_unidade
:pertence_a_unidade rdf:type owl:ObjectProperty ;
                    rdfs:domain :ConceitoDisciplinar ;
                    rdfs:range :UnidadeTematica .


###  http://example.com#possui_unidade
:possui_unidade rdf:type owl:ObjectProperty ;
                rdfs:domain :Disciplina ;
                rdfs:range :UnidadeTematica .


###  http://example.com#precede
:precede rdf:type owl:ObjectProperty ;
         owl:inverseOf :precedido_por ;
         rdf:type owl:TransitiveProperty ;
         rdfs:domain :ConceitoDisciplinar ;
         rdfs:range :ConceitoDisciplinar ;
         rdfs:label "precede"@en .


###  http://example.com#precede_a
:precede_a rdf:type owl:ObjectProperty ;
           owl:inverseOf :sucedido_por ;
           rdf:type owl:TransitiveProperty ;
           rdfs:domain :AnoEscolar ;
           rdfs:range :AnoEscolar .


###  http://example.com#precedido_por
:precedido_por rdf:type owl:ObjectProperty ,
                        owl:TransitiveProperty ;
               rdfs:domain :ConceitoDisciplinar ;
               rdfs:range :ConceitoDisciplinar .


###  http://example.com#relacionaSe_com
:relacionaSe_com rdf:type owl:ObjectProperty ,
                          owl:SymmetricProperty ;
                 rdfs:domain :ConceitoDisciplinar ;
                 rdfs:range :ConceitoDisciplinar .


###  http://example.com#sucedido_por
:sucedido_por rdf:type owl:ObjectProperty ,
                       owl:TransitiveProperty ;
              rdfs:domain :AnoEscolar ;
              rdfs:range :AnoEscolar .


#################################################################
#    Classes
#################################################################

###  http://example.com#AnoEscolar
:AnoEscolar rdf:type owl:Class ;
            rdfs:subClassOf gufo:FunctionalComplex ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty :especifica ;
                              owl:someValuesFrom :ConceitoDisciplinar
                            ] ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty :especifica ;
                              owl:allValuesFrom :ConceitoDisciplinar
                            ] .


###  http://example.com#Compartilha
:Compartilha rdf:type owl:Class ;
             rdfs:subClassOf :ConexaoCurricular .


###  http://example.com#Computacao
:Computacao rdf:type owl:Class ;
            rdfs:subClassOf :Disciplina ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty :possui_unidade ;
                              owl:allValuesFrom :UnidadeTematicaComputacao
                            ] ;
            owl:disjointWith :Matematica .


###  http://example.com#ConceitoBase
:ConceitoBase rdf:type owl:Class ;
              owl:equivalentClass [ owl:intersectionOf ( :ConceitoMatematico
                                                         [ rdf:type owl:Restriction ;
                                                           owl:onProperty :precede ;
                                                           owl:someValuesFrom :ConceitoComputacional
                                                         ]
                                                       ) ;
                                    rdf:type owl:Class
                                  ] .


###  http://example.com#ConceitoComputacional
:ConceitoComputacional rdf:type owl:Class ;
                       owl:equivalentClass [ owl:intersectionOf ( :ConceitoDisciplinar
                                                                  [ rdf:type owl:Restriction ;
                                                                    owl:onProperty :pertence_a_unidade ;
                                                                    owl:someValuesFrom :UnidadeTematicaComputacao
                                                                  ]
                                                                ) ;
                                             rdf:type owl:Class
                                           ] ;
                       rdfs:subClassOf :ConceitoDisciplinar ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty :pertence_a_unidade ;
                                         owl:allValuesFrom :UnidadeTematicaComputacao
                                       ] ;
                       owl:disjointWith :ConceitoMatematico .


###  http://example.com#ConceitoDisciplinar
:ConceitoDisciplinar rdf:type owl:Class ;
                     rdfs:subClassOf gufo:FunctionalComplex ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty :pertence_a_unidade ;
                                       owl:someValuesFrom :UnidadeTematica
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty :pertence_a_unidade ;
                                       owl:allValuesFrom :UnidadeTematica
                                     ] .


###  http://example.com#ConceitoFinal
:ConceitoFinal rdf:type owl:Class ;
               owl:equivalentClass [ owl:intersectionOf ( :ConceitoDisciplinar
                                                          [ rdf:type owl:Class ;
                                                            owl:complementOf [ rdf:type owl:Restriction ;
                                                                               owl:onProperty :precede ;
                                                                               owl:someValuesFrom :ConceitoDisciplinar
                                                                             ]
                                                          ]
                                                        ) ;
                                     rdf:type owl:Class
                                   ] .


###  http://example.com#ConceitoInterdisciplinar
:ConceitoInterdisciplinar rdf:type owl:Class ;
                          owl:equivalentClass [ rdf:type owl:Class ;
                                                owl:unionOf ( [ owl:intersectionOf ( :ConceitoComputacional
                                                                                     [ rdf:type owl:Restriction ;
                                                                                       owl:onProperty :relacionaSe_com ;
                                                                                       owl:someValuesFrom :ConceitoMatematico
                                                                                     ]
                                                                                   ) ;
                                                                rdf:type owl:Class
                                                              ]
                                                              [ owl:intersectionOf ( :ConceitoMatematico
                                                                                     [ rdf:type owl:Restriction ;
                                                                                       owl:onProperty :relacionaSe_com ;
                                                                                       owl:someValuesFrom :ConceitoComputacional
                                                                                     ]
                                                                                   ) ;
                                                                rdf:type owl:Class
                                                              ]
                                                            )
                                              ] .


###  http://example.com#ConceitoMatematico
:ConceitoMatematico rdf:type owl:Class ;
                    owl:equivalentClass [ owl:intersectionOf ( :ConceitoDisciplinar
                                                               [ rdf:type owl:Restriction ;
                                                                 owl:onProperty :pertence_a_unidade ;
                                                                 owl:someValuesFrom :UnidadeTematicaMatematica
                                                               ]
                                                             ) ;
                                          rdf:type owl:Class
                                        ] ;
                    rdfs:subClassOf :ConceitoDisciplinar ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty :pertence_a_unidade ;
                                      owl:allValuesFrom :UnidadeTematicaMatematica
                                    ] .


###  http://example.com#ConexaoCurricular
:ConexaoCurricular rdf:type owl:Class ;
                   rdfs:subClassOf gufo:Relator ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty gufo:mediates ;
                                     owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onClass :AnoEscolar
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty gufo:mediates ;
                                     owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onClass :ConceitoComputacional
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty gufo:mediates ;
                                     owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onClass :ConceitoMatematico
                                   ] .


###  http://example.com#Disciplina
:Disciplina rdf:type owl:Class ;
            rdfs:subClassOf gufo:FunctionalComplex ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty :possui_unidade ;
                              owl:someValuesFrom :UnidadeTematica
                            ] ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty :possui_unidade ;
                              owl:allValuesFrom :UnidadeTematica
                            ] .


###  http://example.com#EnsinoFundamental2
:EnsinoFundamental2 rdf:type owl:Class ;
                    rdfs:subClassOf gufo:FunctionalComplex .


###  http://example.com#Matematica
:Matematica rdf:type owl:Class ;
            rdfs:subClassOf :Disciplina ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty :possui_unidade ;
                              owl:allValuesFrom :UnidadeTematicaMatematica
                            ] .


###  http://example.com#Previsao
:Previsao rdf:type owl:Class ;
          rdfs:subClassOf gufo:Relator ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty gufo:mediates ;
                            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                            owl:onClass :AnoEscolar
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty gufo:mediates ;
                            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                            owl:onClass :ConceitoComputacional
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty gufo:mediates ;
                            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                            owl:onClass :ConceitoMatematico
                          ] .


###  http://example.com#Reforca
:Reforca rdf:type owl:Class ;
         rdfs:subClassOf :ConexaoCurricular .


###  http://example.com#Requer
:Requer rdf:type owl:Class ;
        rdfs:subClassOf :ConexaoCurricular .


###  http://example.com#UnidadeTematica
:UnidadeTematica rdf:type owl:Class ;
                 owl:equivalentClass [ rdf:type owl:Class ;
                                       owl:unionOf ( :UnidadeTematicaComputacao
                                                     :UnidadeTematicaMatematica
                                                   )
                                     ] ;
                 rdfs:subClassOf gufo:FunctionalComplex ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty :pertence_a_disciplina ;
                                   owl:someValuesFrom :Disciplina
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty :pertence_a_disciplina ;
                                   owl:allValuesFrom :Disciplina
                                 ] .


###  http://example.com#UnidadeTematicaComputacao
:UnidadeTematicaComputacao rdf:type owl:Class ;
                           owl:equivalentClass [ owl:intersectionOf ( :UnidadeTematica
                                                                      [ rdf:type owl:Restriction ;
                                                                        owl:onProperty :pertence_a_disciplina ;
                                                                        owl:someValuesFrom :Computacao
                                                                      ]
                                                                    ) ;
                                                 rdf:type owl:Class
                                               ] ;
                           rdfs:subClassOf :UnidadeTematica ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty :pertence_a_disciplina ;
                                             owl:allValuesFrom :Computacao
                                           ] ;
                           owl:disjointWith :UnidadeTematicaMatematica .


###  http://example.com#UnidadeTematicaMatematica
:UnidadeTematicaMatematica rdf:type owl:Class ;
                           owl:equivalentClass [ owl:intersectionOf ( :UnidadeTematica
                                                                      [ rdf:type owl:Restriction ;
                                                                        owl:onProperty :pertence_a_disciplina ;
                                                                        owl:someValuesFrom :Matematica
                                                                      ]
                                                                    ) ;
                                                 rdf:type owl:Class
                                               ] ;
                           rdfs:subClassOf :UnidadeTematica ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty :pertence_a_disciplina ;
                                             owl:allValuesFrom :Matematica
                                           ] .


